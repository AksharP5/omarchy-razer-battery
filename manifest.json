{
  "schemaVersion": 1,
  "id": "akshar.razer-battery",
  "name": "Razer Battery",
  "version": "0.1.1",
  "author": "Akshar Patel",
  "license": "MIT",
  "description": "A minimal mouse icon with Razer battery percentage and charging status on hover.",
  "homepage": "https://github.com/AksharP5/omarchy-razer-battery",
  "repository": "https://github.com/AksharP5/omarchy-razer-battery",
  "keywords": ["razer", "mouse", "battery"],
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Razer Battery",
    "description": "Mouse icon with battery details on hover and a low battery indicator.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
