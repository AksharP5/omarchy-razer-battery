{
  "schemaVersion": 1,
  "id": "akshar.razer-battery",
  "name": "Razer Battery",
  "version": "0.1.0",
  "author": "Akshar Patel",
  "license": "MIT",
  "description": "Razer mouse battery percentage and charging status in the Omarchy bar.",
  "homepage": "https://github.com/AksharP5/omarchy-razer-battery",
  "repository": "https://github.com/AksharP5/omarchy-razer-battery",
  "keywords": ["razer", "mouse", "battery"],
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Razer Battery",
    "description": "Mouse battery percentage, charging status, and low battery indicator.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
